<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid #e6dcc8;">
  <tr>
    <td style="padding:0;background-color:#efe6d8;">
      <% if item.image_url.present? %>
        <a href="<%= item.url %>" style="text-decoration:none;">
          <img src="<%= item.image_url %>" alt="<%= item.caption.presence || 'Фото' %>" width="280" style="display:block;width:100%;max-width:280px;height:auto;border:0;" />
        </a>
      <% else %>
        <p style="margin:24px 12px;font-family:Georgia,serif;color:#7a6e62;text-align:center;">Нет превью</p>
      <% end %>
    </td>
  </tr>
  <tr>
    <td style="padding:10px 12px 12px 12px;font-family:Georgia,'Times New Roman',serif;">
      <% if item.caption.present? %>
        <a href="<%= item.url %>" style="color:#8b3a2a;text-decoration:none;font-size:14px;"><%= item.caption %></a>
      <% end %>
      <p style="margin:<%= item.caption.present? ? '4px 0 0 0' : '0' %>;font-size:12px;color:#7a6e62;">
        <%= item.action == 'create' ? 'Добавлено' : 'Обновлено' %>
        · <%= AdminDigest::Format.datetime(item.occurred_at) %>
        <% if item.actor_email.present? %><br /><%= item.actor_email %><% end %>
      </p>
    </td>
  </tr>
</table>
