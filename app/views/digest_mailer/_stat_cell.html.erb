<td width="33%" valign="top" style="padding:6px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f1e6;border:1px solid #e6dcc8;">
    <tr>
      <td style="padding:12px 10px;text-align:center;font-family:Georgia,'Times New Roman',serif;">
        <div style="font-size:22px;line-height:1.2;color:#3c2415;"><%= value %></div>
        <div style="margin-top:4px;font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#7a6e62;"><%= label %></div>
      </td>
    </tr>
  </table>
</td>
