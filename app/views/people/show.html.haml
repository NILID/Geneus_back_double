.container
  .row
    .col-6
      %h1.h2= @person.name

    .col-6.text-right
      .dropdown
        %a.btn.btn-dark.dropdown-toggle{ href: '#', role: 'button', data: { toggle: "dropdown"}, aria: { haspopup: "true", expanded: "false" } }
          Menu
        .dropdown-menu
          .dropdown-divider
          = link_to 'Current version', @person,           class: 'dropdown-item'
          = link_to 'View history', [:versions, @person], class: 'dropdown-item'

.container.mt-3
  .row
    .col-8
      .row
        .col-12.my-3
          %h2.h3
            Notes
            %small= link_to '+', [:new, @person, :note], class: 'btn btn-dark btn-sm'
        .col-12
          %table.table.table-hover
            = render @person.notes