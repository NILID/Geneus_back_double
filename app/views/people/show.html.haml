.container
  .row
    .col-6
      %h1.h2= @person.full_name

.container.mt-3
  .row
    .col-8
      .row
        .col-12.my-3
          %h2.h3
            Notes
            %small= link_to '+', [:new, @person, :note], class: 'btn btn-dark btn-sm'
        .col-12
          %table.table.table-hover
            = render @person.notes