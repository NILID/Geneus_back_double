BACKEND_HOST=example.com
FRONTEND_URL=https://example.com
# Дополнительные Origin для CORS через запятую (опционально)
# CORS_ORIGINS=https://staging.example.com
INVITATION_INVITE_FOR_HOURS=24
# Обязательно задайте отдельный секрет (rails secret / openssl rand -hex 64)
DEVISE_JWT_SECRET_KEY=
# Принудительный HTTPS в Rails (false только при особой схеме прокси)
# FORCE_SSL=true

# Хранение фото (Active Storage) на Яндекс.Диске
# В oauth.yandex.com включите только «Доступ к папке приложения на Яндекс.Диске»
# (cloud_api:disk.app_folder), без disk.read / disk.write — так API не видит остальной Диск.
# Токен: https://yandex.com/dev/disk-api/doc/en/concepts/quickstart
# YANDEX_DISK_TOKEN=
# Режим папки приложения (рекомендуется true)
# YANDEX_DISK_APP_FOLDER=true
# Общий префикс внутри app:/ (пусто = только avatars/ и photos/ в корне app:/)
# YANDEX_DISK_FOLDER=geneus
# → аватары: app:/geneus/avatars/…  галерея: app:/geneus/photos/…
# Без префикса: app:/avatars/… и app:/photos/…